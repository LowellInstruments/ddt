- id: f775960a-c35f-419e-865a-c4d88a576e26
  type: paragraph
  props:
    backgroundColor: default
    textColor: default
    textAlignment: left
  content:
  - type: text
    text: 'Set your local working directory, usually '
    styles:
      bold: true
  - type: text
    text: '{{ workspace.root }}'
    styles:
      code: true
  children: []
- id: ca213a49-9e3d-413a-af97-72eff8704fc7
  type: local-directory
  props: {}
  children: []
- id: 71285314-85c8-4d2e-b6cb-083a279471a4
  type: local-var
  props:
    name: VAR_DDH_SSH_PASSWORD
    obscured: false
  children: []
- id: 1c659cc3-91da-4585-b7bf-60694e9f3e03
  type: env
  props:
    name: DDH_SSH_PASSWORD
    value: '{{var.VAR_DDH_SSH_PASSWORD}}'
  children: []
- id: 8e833ae3-7a8f-4098-a8ba-f2104021a45f
  type: paragraph
  props:
    backgroundColor: default
    textColor: default
    textAlignment: left
  content:
  - type: text
    text: Detect DDH on specified network
    styles:
      bold: true
  children: []
- id: db4f0bc7-858e-4bff-948c-3a996a7c2f81
  type: dropdown
  props:
    name: dd_local_or_vpn
    options: DDH in my wi-fi:local, DDH in VPN:vpn
    fixedOptions: DDH in my wi-fi:local, DDH in VPN:vpn
    variableOptions: ''
    commandOptions: ''
    value: local
    optionsType: fixed
    interpreter: bash
    delimiter: ':'
  children: []
- id: 2a74970a-1cc3-486c-b130-d63cd75cde52
  type: paragraph
  props:
    backgroundColor: default
    textColor: default
    textAlignment: left
  content:
  - type: text
    text: Among  detected DDH, specify which ones we target
    styles:
      bold: true
  children: []
- id: 62e8cf3e-fa6c-48b9-8ea1-df9d4ce36ff5
  type: dropdown
  props:
    name: dd_all_or_req
    options: all of them:all, only requested:req
    fixedOptions: all of them:all, only requested:req
    variableOptions: ''
    commandOptions: ''
    value: all
    optionsType: fixed
    interpreter: bash
    delimiter: ':'
  children: []
- id: 560a5828-c907-40d5-8988-aded9cc771b3
  type: dropdown
  props:
    name: dd_debug
    options: on:1, off:0
    fixedOptions: on:1, off:0
    variableOptions: ''
    commandOptions: ''
    value: '0'
    optionsType: fixed
    interpreter: zsh
    delimiter: ':'
  children: []
- id: a6fe1a9f-3f32-46a0-8f38-dc3bc5e902b5
  type: paragraph
  props:
    backgroundColor: default
    textColor: default
    textAlignment: left
  content: []
  children: []
- id: e6e95ce3-51bc-4468-9cdd-4d35bf6ee9cb
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Get cell firmware version of target DDH
    code: ./atu_cmd_cell.py {{var.dd_local_or_vpn}} {{var.dd_all_or_req}} {{var.dd_debug}}
    outputVisible: true
    dependency: '{}'
    terminalRows: 28
  children: []
- id: 019d9701-a58c-7563-95ba-0e5186bfbec0
  type: script
  props:
    interpreter: bash
    outputVariable: ''
    name: Get software version of target DDH
    code: ./atu_cmd_version.py {{var.dd_local_or_vpn}} {{var.dd_all_or_req}} {{var.dd_debug}}
    outputVisible: true
    dependency: '{}'
    terminalRows: 28
